// ============================================================
// CÓDIGO PARA GENERAR HASH MD5 DESDE LA CONSOLA DEL NAVEGADOR
// Laboratorio 3 - Auditoría de hash en A3-Club.net
// ============================================================
//
// Este código se ejecuta en la consola del navegador (F12 → Console).
// Carga la librería blueimp-md5 desde un CDN y calcula el hash MD5
// de la contraseña "password123".
//
// Resultado esperado: 482c811da5d5b4bc6d497ffa98491e38
//
// NOTA: Chrome bloquea inicialmente el pegado de código en la consola
// por seguridad. Para habilitarlo, escribe "allow pasting" y presiona Enter.
// ============================================================

// Paso 1: Crear un elemento script para cargar la librería MD5 desde un CDN
var script = document.createElement('script');

// Paso 2: Asignar la URL de la librería blueimp-md5
script.src = 'https://cdnjs.cloudflare.com/ajax/libs/blueimp-md5/2.19.0/js/md5.min.js';

// Paso 3: Añadir el script al head del documento
document.head.appendChild(script);

// Paso 4: Esperar a que la librería cargue y calcular el hash
// Se usa setTimeout para dar tiempo a que el script se cargue (1 segundo)
setTimeout(function() {
    // Calcular el hash MD5 de la contraseña "password123"
    var hash = md5('password123');
    
    // Imprimir el resultado en la consola
    console.log('Hash MD5 de password123:', hash);
    
    // Resultado esperado: 482c811da5d5b4bc6d497ffa98491e38
}, 1000);




